# -------------------------------
# DJANGO SETTINGS
# -------------------------------
DJANGO_SECRET_KEY=REPLACE_WITH_YOUR_SECRET_KEY
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SMTP EMAIL (GMAIL APP PASSWORD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
SMTP_USE_TLS=True

DEFAULT_FROM_EMAIL=your-email@gmail.com
ADMIN_NOTIFICATION_EMAIL=your-email@gmail.com

# OTP SETTINGS
OTP_VALID_SECONDS=60
HF_TOKEN=REPLACE_WITH_HF_TOKEN
